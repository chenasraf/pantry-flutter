<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WearLaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/wear_splash_icon</item>
        <item name="postSplashScreenTheme">@style/WearNormalTheme</item>
        <item name="android:windowSwipeToDismiss">@bool/wear_swipe_to_dismiss</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="WearNormalTheme" parent="@style/NormalTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSwipeToDismiss">@bool/wear_swipe_to_dismiss</item>
    </style>
</resources>
