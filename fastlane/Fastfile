require "digest"
require "json"
require "tmpdir"

# -- Shared helpers --

def version_info
  pubspec = File.read(File.expand_path("../pubspec.yaml", __dir__))
  version = pubspec.match(/^version:\s*(.+)$/)[1].strip
  name, build = version.split("+")
  { name: name, build: build }
end

def version_name
  v = version_info
  "#{v[:build]} (#{v[:name]})"
end

# The notes written for one store (`play`, `wear`, `ios`, `macos`), from
# release-notes/<version>/ — see release-notes/config.yml.
def release_notes_for(destination)
  version = version_info[:name]
  path = File.expand_path("../release-notes/#{version}/#{destination}.txt", __dir__)
  UI.user_error!("No #{destination} release notes at #{path}. Write the notes for #{version} first (see release-notes/README.md).") unless File.exist?(path)
  notes = File.read(path).strip
  UI.message("Loaded #{destination} release notes for #{version} (#{notes.length} chars)")
  notes
end

# -- Android --

default_platform(:android)

platform :android do
  # supply reads release notes only from <metadata>/<locale>/changelogs/<versionCode>.txt.
  # Written without a trailing newline: Play counts it against the 500 limit.
  def write_play_changelog(metadata_dir, version_code, notes)
    changelog_dir = File.join(metadata_dir, "en-US", "changelogs")
    FileUtils.mkdir_p(changelog_dir)
    File.write(File.join(changelog_dir, "#{version_code}.txt"), notes)
  end

  # -- Image change detection --

  IMAGE_HASH_CACHE = File.expand_path(".image_hashes.json", __dir__)

  def current_image_hashes
    root = File.expand_path("metadata/android", __dir__)
    return {} unless Dir.exist?(root)

    files = Dir.glob(File.join(root, "**/images/**/*")).select { |f| File.file?(f) }
    files.sort.each_with_object({}) do |path, acc|
      rel = path.sub("#{root}/", "")
      acc[rel] = Digest::SHA256.file(path).hexdigest
    end
  end

  def cached_image_hashes
    return {} unless File.exist?(IMAGE_HASH_CACHE)
    JSON.parse(File.read(IMAGE_HASH_CACHE))
  rescue StandardError
    {}
  end

  def images_changed?
    current_image_hashes != cached_image_hashes
  end

  def save_image_hashes
    File.write(IMAGE_HASH_CACHE, JSON.pretty_generate(current_image_hashes))
  end

  desc "Upload AAB to Google Play"
  lane :deploy do |options|
    # The same path is F-Droid's changelog, which CI copies from play.txt on
    # the release PR, so this rewrites it with identical text.
    write_play_changelog(File.expand_path("metadata/android", __dir__), version_info[:build], release_notes_for("play"))

    changed = images_changed?
    UI.message(changed ? "Images changed — uploading." : "Images unchanged — skipping.")

    upload_to_play_store(
      aab: File.expand_path("../build/app/outputs/bundle/phoneRelease/app-phone-release.aab", __dir__),
      track: options[:track] || "production",
      release_status: options[:status] || "completed",
      version_name: version_name,
      metadata_path: File.expand_path("metadata/android", __dir__),
      skip_upload_images: !changed,
      skip_upload_screenshots: !changed,
    )

    save_image_hashes if changed
  end

  # Mirrors the wear flavor's versionCode offset in android/app/build.gradle.kts:
  # a version code has to be unique across form factors, and Play resolves the
  # release notes for an upload by the code of the artifact being uploaded.
  WEAR_VERSION_CODE_OFFSET = 20_000

  desc "Upload the Wear OS AAB to Google Play's wear track"
  lane :deploy_wear do |options|
    version_code = version_info[:build].to_i + WEAR_VERSION_CODE_OFFSET
    notes = release_notes_for("wear")

    # The listing is shared and belongs to the phone lane: Play has no
    # per-form-factor description, and the wear screenshots it does keep
    # separate live under metadata/android, which `deploy` already uploads.
    # The metadata dir here only carries the changelog.
    Dir.mktmpdir("pantry-wear-metadata") do |metadata_dir|
      write_play_changelog(metadata_dir, version_code, notes)
      upload_to_play_store(
        aab: File.expand_path("../build/app/outputs/bundle/wearRelease/app-wear-release.aab", __dir__),
        track: "wear:#{options[:track] || "production"}",
        release_status: options[:status] || "completed",
        version_name: version_name,
        metadata_path: metadata_dir,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
      )
    end
  end

  desc "Sync metadata and screenshots only (no AAB upload)"
  lane :metadata do
    changed = images_changed?
    UI.message(changed ? "Images changed — uploading." : "Images unchanged — skipping.")

    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      metadata_path: File.expand_path("metadata/android", __dir__),
      skip_upload_images: !changed,
      skip_upload_screenshots: !changed,
    )

    save_image_hashes if changed
  end

  desc "Promote a release from one track to another"
  lane :promote do |options|
    from = options[:from] || "internal"
    to = options[:to] || "production"
    status = options[:status] || "completed"

    upload_to_play_store(
      track: from,
      track_promote_to: to,
      release_status: status,
      version_name: version_name,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end

# -- iOS --

platform :ios do
  def api_key
    key_id = ENV.fetch("APP_STORE_API_KEY")
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: ENV.fetch("APP_STORE_ISSUER_ID"),
      key_filepath: File.join(ENV.fetch("APP_STORE_KEY_PATH"), "AuthKey_#{key_id}.p8"),
    )
  end

  def find_ipa
    ipa_path = Dir[File.expand_path("../build/ios/ipa/*.ipa", __dir__)].first
    UI.user_error!("No IPA found in build/ios/ipa/. Run 'make ios-build' first.") unless ipa_path
    ipa_path
  end

  def release_notes
    release_notes_for("ios")
  end

  desc "Upload to TestFlight"
  lane :beta do
    upload_to_testflight(
      api_key: api_key,
      ipa: find_ipa,
      changelog: release_notes,
      skip_waiting_for_build_processing: true,
    )
  end

  # True if this exact iOS build is already on App Store Connect, so a re-run
  # of the deploy can skip the (duplicate, rejected) binary upload.
  def ios_binary_already_uploaded?(key)
    latest = app_store_build_number(
      api_key: key,
      app_identifier: "dev.casraf.pantry",
      platform: "ios",
      version: version_info[:name],
      live: false,
      initial_build_number: 0,
    )
    latest.to_i >= version_info[:build].to_i
  rescue => e
    UI.message("Could not look up latest iOS build (#{e.message}); proceeding with upload.")
    false
  end

  desc "Upload to App Store"
  lane :release do |options|
    key = api_key
    submit = options[:status] != "draft"
    skip_binary = ios_binary_already_uploaded?(key)
    if skip_binary
      UI.important("Build #{version_info[:build]} already uploaded — skipping binary, syncing metadata#{submit ? ' and submitting' : ''}.")
    end

    deliver(
      api_key: key,
      ipa: skip_binary ? nil : find_ipa,
      skip_binary_upload: skip_binary,
      release_notes: { "en-US" => release_notes },
      metadata_path: File.expand_path("metadata/ios", __dir__),
      screenshots_path: File.expand_path("metadata/ios/en-US/screenshots", __dir__),
      skip_screenshots: true,
      submit_for_review: submit,
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end

  desc "Sync iOS metadata only (no IPA upload)"
  lane :metadata do
    deliver(
      api_key: api_key,
      release_notes: { "en-US" => release_notes },
      metadata_path: File.expand_path("metadata/ios", __dir__),
      screenshots_path: File.expand_path("metadata/ios/en-US/screenshots", __dir__),
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end

  desc "Submit existing App Store build for review (no IPA upload)"
  lane :submit do
    deliver(
      api_key: api_key,
      release_notes: { "en-US" => release_notes },
      metadata_path: File.expand_path("metadata/ios", __dir__),
      screenshots_path: File.expand_path("metadata/ios/en-US/screenshots", __dir__),
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end
end

# -- macOS --

platform :mac do
  def api_key
    key_id = ENV.fetch("APP_STORE_API_KEY")
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: ENV.fetch("APP_STORE_ISSUER_ID"),
      key_filepath: File.join(ENV.fetch("APP_STORE_KEY_PATH"), "AuthKey_#{key_id}.p8"),
      set_spaceship_token: true,
    )
  end

  def find_pkg
    pkg_path = Dir[File.expand_path("../build/macos/pkg/*.pkg", __dir__)].first
    UI.user_error!("No PKG found in build/macos/pkg/. Run 'make macos-build-pkg' first.") unless pkg_path
    pkg_path
  end

  def release_notes
    release_notes_for("macos")
  end

  desc "Upload to TestFlight (macOS)"
  lane :beta do
    upload_to_testflight(
      api_key: api_key,
      pkg: find_pkg,
      app_platform: "osx",
      changelog: release_notes,
      skip_waiting_for_build_processing: true,
    )
  end

  # macOS CFBundleVersion is offset by 10000 (see Makefile) so it never
  # collides with iOS under the shared bundle ID.
  def macos_build_number
    version_info[:build].to_i + 10_000
  end

  # True only when this exact macOS build (CFBundleVersion == macos_build_number)
  # is already on App Store Connect, so a re-run can skip the duplicate binary
  # upload. Queries the build list directly and matches the build number on the
  # osx platform: app_store_build_number resolves by version *string* (shared
  # across the iOS and macOS trains under one bundle id), which returned a false
  # positive and skipped a needed upload.
  def macos_binary_already_uploaded?
    app = Spaceship::ConnectAPI::App.find("dev.casraf.pantry")
    target = macos_build_number.to_s
    builds = Spaceship::ConnectAPI.get_builds(
      filter: { app: app.id },
      includes: "preReleaseVersion",
      sort: "-uploadedDate",
      limit: 50,
    ).to_models
    builds.any? do |b|
      b.version == target &&
        b.pre_release_version&.platform == "MAC_OS" &&
        b.processing_state != "INVALID"
    end
  rescue => e
    UI.message("Could not look up macOS build #{macos_build_number} (#{e.message}); proceeding with upload.")
    false
  end

  desc "Upload to Mac App Store"
  lane :release do |options|
    key = api_key
    submit = options[:status] != "draft"
    skip_binary = macos_binary_already_uploaded?
    if skip_binary
      UI.important("Build #{macos_build_number} already uploaded — skipping binary, syncing metadata#{submit ? ' and submitting' : ''}.")
    end

    deliver(
      api_key: key,
      pkg: skip_binary ? nil : find_pkg,
      skip_binary_upload: skip_binary,
      platform: "osx",
      release_notes: { "en-US" => release_notes },
      metadata_path: File.expand_path("metadata/macos", __dir__),
      screenshots_path: File.expand_path("metadata/macos/en-US/screenshots", __dir__),
      skip_screenshots: true,
      submit_for_review: submit,
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end

  desc "Sync macOS metadata only (no PKG upload)"
  lane :metadata do
    deliver(
      api_key: api_key,
      platform: "osx",
      release_notes: { "en-US" => release_notes },
      metadata_path: File.expand_path("metadata/macos", __dir__),
      screenshots_path: File.expand_path("metadata/macos/en-US/screenshots", __dir__),
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end

  desc "Submit existing Mac App Store build for review (no PKG upload)"
  lane :submit do
    deliver(
      api_key: api_key,
      platform: "osx",
      release_notes: { "en-US" => release_notes },
      metadata_path: File.expand_path("metadata/macos", __dir__),
      screenshots_path: File.expand_path("metadata/macos/en-US/screenshots", __dir__),
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end
end
